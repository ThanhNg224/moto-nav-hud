<template>
  <div class="page" onswipe="onSwipe">
    <!-- Vòng cung tiến độ 270° dọc viền tròn (Beeline / Wear OS HUD) -->
    <progress class="ring {{ringClass}}" type="arc" percent="{{arcPercent}}"></progress>

    <!-- Chế độ dẫn đường: vòng tròn nền & mũi tên 108x108 đồng tâm tuyệt đối tại (240, 98) -->
    <div class="dial {{dialClass}}" if="{{arrow}}"></div>
    <div class="dial-in {{dialInClass}}" if="{{arrow}}"></div>
    <image class="arrow" src="{{arrow}}" if="{{arrow}}"></image>

    <!-- Huy hiệu lối ra vòng xuyến: nằm tách biệt bên phải dial, không đè dial hay viền tròn -->
    <div class="exit-pill" if="{{exitBadge}}">
      <text class="exit-txt">{{exitBadge}}</text>
    </div>

    <!-- Giờ hiện tại nhỏ ở góc trên phải (HH:mm, luôn hiện; lớp Cài đặt phủ lên khi mở) -->
    <text class="clock-top" if="{{clockNow}}">{{clockNow}}</text>

    <!-- Khoảng cách lớn & tên đường -->
    <text class="dist {{distClass}}" if="{{distance}}">{{distance}}</text>
    <!-- Dấu "cũ Ns": tin Maps đã lâu chưa đổi (yên lặng), đối xứng huy hiệu LỐI bên trái dial -->
    <text class="quiet-mark" if="{{quietMark}}">{{quietMark}}</text>
    <text class="street" if="{{street}}">{{street}}</text>

    <!-- Viên thuốc ETA / km còn lại (chạm để chuyển đổi đồng hồ giờ hiện tại) -->
    <div class="pill-wrap" if="{{bottomText}}" onclick="onToggleClock">
      <text class="bottom">{{bottomText}}</text>
    </div>

    <!-- Biểu tượng MotoNav 68x68 ở màn chờ -->
    <image class="emblem" src="/common/emblem.png" if="{{showWaitActions}}"></image>

    <!-- Màn chờ / Tính lại / Đã đến / Mất dữ liệu -->
    <text class="banner {{bannerClass}}" if="{{banner}}">{{banner}}</text>
    <text class="hint {{hintClass}}" if="{{hint}}">{{hint}}</text>

    <!-- Nút nhanh ở màn chờ (chữ thuần Việt rõ nét, không dùng ký tự đặc biệt dễ vỡ font) -->
    <div class="wait-actions" if="{{showWaitActions}}">
      <div class="wbtn wbtn-demo" onclick="onTapDemo">
        <text class="wbtn-txt">{{demoBtnWait}}</text>
      </div>
      <div class="wbtn wbtn-cfg" onclick="onOpenMenu">
        <text class="wbtn-txt">{{settingsLabel}}</text>
      </div>
    </div>

    <!-- Thanh trạng thái đáy (có chấm màu + dư chiều cao cho dấu tiếng Việt) -->
    <text class="st st1" if="{{status1}}">{{status1}}</text>
    <div class="st-row" if="{{status2}}" onclick="onStatusTap">
      <div class="dot {{dotClass}}"></div>
      <text class="st-txt {{statusClass}}">{{status2}}</text>
    </div>
    <text class="st3" if="{{status3}}">{{status3}}</text>

    <!-- Bảng Cài đặt nhanh (vuốt lên hoặc bấm Cài đặt) -->
    <div class="menu" if="{{menuOpen}}">
      <text class="menu-title">MotoNav</text>
      <div class="mbtn mbtn-accent" onclick="onCyclePreset">
        <text class="mbtn-txt">{{presetLabel}}</text>
      </div>
      <div class="mbtn" onclick="onCycleBright">
        <text class="mbtn-txt">{{brightLabel}}</text>
      </div>
      <div class="mbtn" onclick="onToggleDemoFromMenu">
        <text class="mbtn-txt">{{demoBtnLabel}}</text>
      </div>
      <div class="mbtn mbtn-close" onclick="onCloseMenu">
        <text class="mbtn-txt">{{closeLabel}}</text>
      </div>
    </div>
  </div>
</template>

<style>
/* BẢNG MÀU (.ux không có biến CSS: dùng đúng các mã này, test chặn mã gần trùng cũ)
   nền #000000 | teal/đang hoạt động #2dd4bf | ổn/đã kết nối/đã đến #34d399 | thận trọng/xa/đang kết nối #ffd000
   sắp rẽ/cam #ff5a36 | nguy hiểm/mất dữ liệu #ef4444 | chữ phụ #94a3b8 (>= 4.5:1 trên nền đen) */
/* Màn tròn 480x480 AMOLED (tâm 240,240; bán kính 240). Nền đen tuyệt đối tiết kiệm pin & giảm chói đêm */
.page {
  width: 480px;
  height: 480px;
  background-color: #000000;
}
/* Vòng cung 270° ôm mép trên (225° -> 135° theo chiều kim đồng hồ); mép trong vòng cung ở r = 223px */
.ring {
  position: absolute;
  left: 0px;
  top: 0px;
  width: 480px;
  height: 480px;
  center-x: 240px;
  center-y: 240px;
  radius: 228px;
  start-angle: 225deg;
  total-angle: 270deg;
  stroke-width: 10px;
  layer-color: #161e2b;
  color: #2dd4bf;
}
.ring-idle { color: #334155; }
.ring-nav { color: #2dd4bf; }
.ring-far { color: #ffd000; }
.ring-near { color: #ff5a36; }
.ring-recalc { color: #ffd000; }
.ring-arrived { color: #34d399; }
.ring-stale { color: #ef4444; }

/* Khung tròn chứa mũi tên: tâm (240, 98), mép trên y = 32 (r = 208px < 223px) */
/* Viền 3px KHÔNG dùng `border` (không rõ width có gồm viền hay không -> tâm lệch 3px): vòng ngoài 132 màu viền,
   vòng trong 126 màu nền, cùng tâm (240, 98) bất kể mô hình hộp. */
.dial {
  position: absolute;
  left: 174px;
  top: 32px;
  width: 132px;
  height: 132px;
  border-radius: 66px;
  background-color: #223044;
}
.dial-far { background-color: #ffd000; }
.dial-near { background-color: #ff5a36; }
.dial-in {
  position: absolute;
  left: 177px;
  top: 35px;
  width: 126px;
  height: 126px;
  border-radius: 63px;
  background-color: #101620;
}
.dial-in-far { background-color: #241d00; }
.dial-in-near { background-color: #2c100a; }
/* Ảnh PNG 108x108 hiển thị đúng tỷ lệ 1:1, đồng tâm tuyệt đối với .dial tại (240, 98) */
.arrow {
  position: absolute;
  left: 186px;
  top: 44px;
  width: 108px;
  height: 108px;
  object-fit: contain;
}

/* Huy hiệu lối ra vòng xuyến: cách mép phải dial 10px, cách mép trên dist 28px, góc ngoài r = 211.7px < 223px */
.exit-pill {
  position: absolute;
  left: 316px;
  top: 106px;
  width: 88px;
  height: 36px;
  border-radius: 18px;
  background-color: #ffd000;
  justify-content: center;
  align-items: center;
}
.exit-txt {
  width: 84px;
  height: 30px;
  font-size: 21px;
  font-weight: bold;
  color: #000000;
  text-align: center;
}

/* Giờ nhỏ góc trên phải: bên phải dial (mép phải 306), trên huy hiệu LỐI (top 106); góc ngoài r = 219.3px < 223px */
.clock-top {
  position: absolute;
  left: 314px;
  top: 68px;
  width: 62px;
  height: 28px;
  font-size: 20px;
  font-weight: bold;
  color: #94a3b8;
  text-align: center;
  lines: 1;
}

/* Khoảng cách: góc trên r = 208.1px < 223px */
.dist {
  position: absolute;
  left: 44px;
  top: 170px;
  width: 392px;
  height: 82px;
  font-size: 68px;
  font-weight: bold;
  color: #ffffff;
  text-align: center;
}
.dist-far { color: #ffd000; }
.dist-near { color: #ff5a36; }

/* Dấu tin cũ: bên trái dial (186..294), cách mép trái dial 20px; góc ngoài r < 223px */
.quiet-mark {
  position: absolute;
  left: 70px;
  top: 106px;
  width: 96px;
  height: 36px;
  font-size: 20px;
  color: #94a3b8;
  text-align: center;
}

/* Tên đường tối đa 2 dòng: góc dưới r = 202.3px < 223px */
.street {
  position: absolute;
  left: 56px;
  top: 254px;
  width: 368px;
  height: 70px;
  font-size: 26px;
  font-weight: bold;
  color: #f1f5f9;
  text-align: center;
  lines: 2;
  text-overflow: ellipsis;
}

/* Viên thuốc ETA / km còn lại / giờ: góc dưới r = 193.8px < 223px */
.pill-wrap {
  position: absolute;
  left: 100px;
  top: 332px;
  width: 280px;
  height: 42px;
  border-radius: 21px;
  background-color: #141c27;
  justify-content: center;
  align-items: center;
}
.bottom {
  width: 264px;
  height: 32px;
  font-size: 22px;
  font-weight: bold;
  color: #cbd5e1;
  text-align: center;
  lines: 1;
  text-overflow: ellipsis;
}

/* Biểu tượng MotoNav 68x68 (1:1) ở đỉnh màn chờ */
.emblem {
  position: absolute;
  left: 206px;
  top: 50px;
  width: 68px;
  height: 68px;
  object-fit: contain;
}

/* Màn trạng thái (chờ / tính lại / đến / mất dữ liệu): góc trên r = 210.3px < 223px */
.banner {
  position: absolute;
  left: 62px;
  top: 130px;
  width: 356px;
  height: 64px;
  font-size: 40px;
  font-weight: bold;
  color: #ffd000;
  text-align: center;
}
.banner-center { top: 180px; }
.banner-wait { color: #ffffff; }
.banner-stale { color: #ef4444; }
.banner-arrived { color: #34d399; }

.hint {
  position: absolute;
  left: 64px;
  top: 202px;
  width: 352px;
  height: 60px;
  font-size: 22px;
  font-weight: bold;
  color: #94a3b8;
  text-align: center;
  lines: 2;
  text-overflow: ellipsis;
}
.hint-center { top: 256px; }

.wait-actions {
  position: absolute;
  left: 78px;
  top: 274px;
  width: 324px;
  height: 60px;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}
.wbtn {
  width: 154px;
  height: 58px;
  border-radius: 29px;
  justify-content: center;
  align-items: center;
}
.wbtn-demo { background-color: #0f766e; }
.wbtn-cfg { background-color: #1e293b; }
.wbtn-txt {
  width: 146px;
  height: 32px;
  font-size: 22px;
  font-weight: bold;
  color: #ffffff;
  text-align: center;
}

/* Dòng trạng thái đáy: nằm trong khe mở đáy của vòng cung 270°, cao 38px không cắt dấu Việt */
.st {
  position: absolute;
  left: 100px;
  width: 280px;
  height: 28px;
  font-size: 18px;
  font-weight: bold;
  color: #9be59b;
  text-align: center;
  lines: 1;
  text-overflow: ellipsis;
}
.st1 { top: 358px; }
.st-row {
  position: absolute;
  left: 95px;
  top: 374px;
  width: 290px;
  height: 56px;
  padding-top: 10px;
  flex-direction: row;
  justify-content: center;
  align-items: center;
}
.dot {
  width: 10px;
  height: 10px;
  border-radius: 5px;
  margin-right: 8px;
  background-color: #ffd000;
}
.dot-ok { background-color: #34d399; }
.dot-warn { background-color: #ffd000; }
/* Chỉ chấm trạng thái nhấp nháy (opacity, 1.5 s); bỏ class = chấm đứng yên (dự phòng giảm chuyển động) */
.dot-pulse {
  animation-name: dotPulse;
  animation-duration: 1500ms;
  animation-iteration-count: infinite;
  animation-timing-function: ease-in-out;
}
@keyframes dotPulse {
  0% { opacity: 1; }
  50% { opacity: 0.25; }
  100% { opacity: 1; }
}
.dot-err { background-color: #ef4444; }
.st-txt {
  width: 262px;
  height: 32px;
  font-size: 19px;
  font-weight: bold;
  color: #34d399;
  text-align: center;
  lines: 1;
  text-overflow: ellipsis;
}
.st-ok { color: #34d399; }
.st-warn { color: #ffd000; }
.st-err { color: #ef4444; }
.st3 {
  position: absolute;
  left: 140px;
  top: 426px;
  width: 200px;
  height: 28px;
  font-size: 16px;
  font-weight: bold;
  color: #ffd000;
  text-align: center;
  lines: 1;
  text-overflow: ellipsis;
}

/* Lớp phủ Cài đặt nhanh */
.menu {
  position: absolute;
  left: 0px;
  top: 0px;
  width: 480px;
  height: 480px;
  background-color: #05070a;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.menu-title {
  width: 280px;
  height: 42px;
  font-size: 26px;
  font-weight: bold;
  color: #ffffff;
  text-align: center;
  margin-bottom: 14px;
}
.mbtn {
  width: 316px;
  height: 56px;
  border-radius: 28px;
  background-color: #1e293b;
  justify-content: center;
  align-items: center;
  margin-bottom: 12px;
}
.mbtn-accent { background-color: #0369a1; }
.mbtn-close {
  width: 170px;
  height: 56px;
  border-radius: 28px;
  background-color: #334155;
  margin-bottom: 0px;
}
.mbtn-txt {
  width: 300px;
  height: 32px;
  font-size: 21px;
  font-weight: bold;
  color: #f8fafc;
  text-align: center;
  lines: 1;
  text-overflow: ellipsis;
}
</style>

<script>
import brightness from '@system.brightness'
import vibrator from '@system.vibrator'
import storage from '@system.storage'

const hud = require('../../common/hud-logic.js')
const cfg = require('../../common/config.js')
const haptics = require('../../common/haptics.js')
const ic = require('../../common/transport-interconnect.js')
const ble = require('../../common/transport-ble.js')
const shortSt = require('../../common/status.js')
const L = require('../../common/log.js')
const i18n = require('../../common/i18n.js')

const KEY_PRESET = 'haptic_preset'
const KEY_BRIGHT = 'bright_mode'
const BRIGHT_ORDER = ['auto', 'day', 'night']

let live = hud.createState()   // trạng thái tin thật
let demo = null                // trạng thái chạy thử cục bộ (tách khỏi live); null = không chạy
let transports = []
let renderTimer = null
let renderMs = 0
let demoTimer = null
let demoStepIdx = 0
let demoSubTick = 0
let demoQ = 0
let channel = ''
let statusA = ''
let statusC = ''
let extra = ''
let diagC = ''
let connPhase = 'SEARCHING'    // pha kết nối do transport báo (status.PHASE)
let phoneDemo = false          // khung gần nhất do ĐT chạy thử (y=1)
let preRide = false            // đang ở màn chờ (chưa có hướng dẫn)
let keepOnFailed = false
let routeActive = false        // đã có hướng dẫn kể từ lần chờ gần nhất (để phân biệt mất tin giữa tuyến)
let tickN = 0
let tickTimer = null
let buzz = null
let lastMode = ''
let presetKey = 'std'
let brightMode = 'auto'        // 'auto' (giữ nguyên hệ thống) | 'day' (230) | 'night' (80)
let origMode = -1              // 0 thủ công | 1 tự động | -1 chưa đọc được
let origBrightness = -1
let baselineModeDone = false
let baselineValDone = false
let baselineDone = false
let overrideApplied = false
let showClock = false
let pageGen = 0
let visible = false
let userTouchedPreset = false
let userTouchedBright = false

function pad2(n) { return n < 10 ? '0' + n : String(n) }
function clockStr() {
  const d = new Date()
  return pad2(d.getHours()) + ':' + pad2(d.getMinutes())
}

export default {
  private: {
    arcPercent: 0,
    ringClass: 'ring-idle',
    dialClass: '',
    dialInClass: '',
    arrow: '',
    exitBadge: '',
    distance: '',
    distClass: '',
    quietMark: '',
    clockNow: '',
    banner: '',
    bannerClass: 'banner-wait',
    hint: '',
    hintClass: '',
    showWaitActions: true,
    street: '',
    bottomText: '',
    status1: '',
    status2: '',
    statusClass: 'st-warn',
    dotClass: 'dot-warn',
    status3: '',
    menuOpen: false,
    presetLabel: '',
    brightLabel: '',
    demoBtnLabel: '',
    demoBtnWait: '',
    settingsLabel: '',
    closeLabel: ''
  },

  onShow() {
    const my = ++pageGen
    visible = true
    i18n.init()
    keepOnFailed = false
    origMode = -1
    origBrightness = -1
    baselineModeDone = false
    baselineValDone = false
    baselineDone = false
    overrideApplied = false
    userTouchedPreset = false
    userTouchedBright = false
    this.loadPrefs(my)
    this.captureBrightnessBaseline(my)
    try {
      brightness.setKeepScreenOn({
        keepScreenOn: true,
        fail: (data, code) => { if (visible && my === pageGen) { extra = 'sáng lỗi ' + code; keepOnFailed = true; this.refreshStatus() } }
      })
    } catch (e) { extra = 'sáng ' + e; keepOnFailed = true }
    this.startAll()
  },
  onHide() { visible = false; pageGen++; this.stopAll(true); this.refreshStatus() },
  onDestroy() { visible = false; pageGen++; this.stopAll(true) },

  captureBrightnessBaseline(my) {
    const finish = () => {
      if (!visible || my !== pageGen || baselineDone) return
      if (baselineModeDone && baselineValDone) {
        baselineDone = true
        if (brightMode !== 'auto') this.applyBrightness()
      }
    }
    try {
      if (typeof brightness.getMode === 'function') {
        brightness.getMode({
          success: (d) => {
            if (visible && my === pageGen && d && typeof d.mode === 'number') origMode = d.mode
          },
          complete: () => { if (my !== pageGen) return; baselineModeDone = true; finish() }
        })
      } else {
        baselineModeDone = true
      }
    } catch (e) { baselineModeDone = true }
    try {
      brightness.getValue({
        success: (d) => {
          if (visible && my === pageGen && d && typeof d.value === 'number') origBrightness = d.value
        },
        complete: () => { if (my !== pageGen) return; baselineValDone = true; finish() }
      })
    } catch (e) { baselineValDone = true; finish() }
  },

  loadPrefs(my) {
    try {
      storage.get({
        key: KEY_PRESET,
        default: 'std',
        success: (v) => {
          if (!visible || my !== pageGen || userTouchedPreset) return
          presetKey = hud.applyPreset(live, v)
          if (demo) hud.applyPreset(demo, presetKey)
          this.syncMenuLabels()
        }
      })
      storage.get({
        key: KEY_BRIGHT,
        default: 'auto',
        success: (v) => {
          if (!visible || my !== pageGen || userTouchedBright) return
          brightMode = BRIGHT_ORDER.indexOf(v) >= 0 ? v : 'auto'
          if (baselineDone) this.applyBrightness()
          this.syncMenuLabels()
        }
      })
    } catch (e) {}
  },

  applyBrightness() {
    if (!visible || !baselineDone) return
    if (brightMode === 'auto') {
      // Ở chế độ Tự động: không ghi đè; chỉ khôi phục lại chính sách gốc nếu trước đó đã ghi đè.
      if (overrideApplied) this.restoreBrightnessPolicyOnly()
      return
    }
    // Chỉ ghi đè khi đã đọc được giá trị hoặc chế độ gốc đủ để khôi phục an toàn lúc rời app
    if (origBrightness < 0 && origMode !== 1) return
    overrideApplied = true
    try { if (origMode >= 0 && typeof brightness.setMode === 'function') brightness.setMode({ mode: 0 }) } catch (e) {}
    try { brightness.setValue({ value: brightMode === 'night' ? 80 : 230 }) } catch (e) {}
  },

  restoreBrightnessPolicyOnly() {
    if (!overrideApplied) return
    overrideApplied = false
    try {
      if (origMode >= 0 && typeof brightness.setMode === 'function') brightness.setMode({ mode: origMode })
      if (origMode !== 1 && origBrightness >= 0) brightness.setValue({ value: origBrightness })
    } catch (e) {}
  },

  restoreBrightness() {
    this.restoreBrightnessPolicyOnly()
    try { brightness.setKeepScreenOn({ keepScreenOn: false }) } catch (e) {}
  },

  startAll() {
    this.stopAll(false)
    live = hud.createState()
    routeActive = false
    hud.applyPreset(live, presetKey)
    channel = ''
    statusA = ''
    statusC = ''
    connPhase = 'SEARCHING'
    buzz = haptics.create(vibrator, (e) => { extra = e; this.refreshStatus() })
    const self = this
    const mk = (m, tag) => m.create({
      onMessage: (str) => self.onRaw(str, tag),
      onStatus: (s) => { if (tag === 'A') statusA = s; else statusC = s; self.refreshStatus() },
      onDiag: (d) => { diagC = d; self.refreshStatus() },
      onPhase: (p) => { if (tag === 'C') { connPhase = p; self.refreshStatus() } },
      onLost: () => self.onLost(tag)
    })
    transports = cfg.ENABLE_INTERCONNECT ? [mk(ic, 'A'), mk(ble, 'C')] : [mk(ble, 'C')]
    transports.forEach((t) => { try { t.start() } catch (e) { extra = 'start ' + e } })
    this.syncRenderTimer(false)
    tickN = 0
    if (cfg.DEBUG_STATUS) {
      tickTimer = setInterval(() => { tickN++; self.refreshStatus() }, 1000)
    }
    this.syncMenuLabels()
    this.render()
  },

  // Tiết kiệm CPU/pin: 500 ms khi đang dẫn đường/chạy thử (bắt kịp ngưỡng stale 3 s), 1500 ms khi đang chờ rảnh
  syncRenderTimer(fast) {
    const want = fast ? 500 : 1500
    if (renderTimer && renderMs === want) return
    if (renderTimer) { clearInterval(renderTimer); renderTimer = null }
    renderMs = want
    renderTimer = setInterval(() => this.render(), want)
  },

  stopAll(release) {
    transports.forEach((t) => { try { t.stop() } catch (e) {} })
    transports = []
    if (renderTimer) { clearInterval(renderTimer); renderTimer = null; renderMs = 0 }
    if (tickTimer) { clearInterval(tickTimer); tickTimer = null }
    this.stopDemo()
    if (buzz) buzz.cancel()
    if (release) this.restoreBrightness()
  },

  // Trả true chỉ khi tin được bộ lọc z/q CHẤP NHẬN (transport dùng làm "kênh còn sống")
  onRaw(str, tag) {
    const msg = hud.parsePayload(str)
    if (!msg) return false
    const r = hud.accept(live, msg, Date.now())
    if (!r.accepted) { L.count('hud.drop'); return false }
    L.count('hud.accept')
    channel = tag
    if (msg.k !== 0 && demo) this.stopDemo()
    if (!demo) this.applyVibe(r)
    this.render()
    return true
  },

  onLost(tag) {
    if (tag !== channel) return
    channel = ''
    const v = hud.invalidate(live)
    L.log('lost', 'channel=' + tag, v ? 'pulse' : 'no-pulse')
    if (!demo) { if (v) { this.dismissMenu(); buzz.cancel(); buzz.play(v) } else buzz.cancelTurn() }
    this.render()
  },

  // Đóng lớp phủ Cài đặt trước khi rung/đổi hướng dẫn để không bao giờ rung khi mũi tên đang bị che
  dismissMenu() { if (this.menuOpen) this.setMenu(false) },

  applyVibe(r) {
    if (r.vibe) { this.dismissMenu(); buzz.play(r.vibe) }
    else if (r.cancel) buzz.cancelTurn()
  },

  setField(k, v) { if (this[k] !== v) this[k] = v },

  syncMenuLabels() {
    this.setField('presetLabel', i18n.t('menu.haptics', hud.presetLabel(presetKey)))
    this.setField('brightLabel', i18n.t('bright.' + (BRIGHT_ORDER.indexOf(brightMode) >= 0 ? brightMode : 'auto')))
    this.setField('demoBtnLabel', i18n.t(demo ? 'btn.demoStop' : 'btn.demo'))
    this.setField('demoBtnWait', i18n.t('btn.demo'))
    this.setField('settingsLabel', i18n.t('btn.settings'))
    this.setField('closeLabel', i18n.t('btn.close'))
  },

  setMenu(open) {
    this.setField('menuOpen', open)
    this.refreshStatus()
  },

  refreshStatus() {
    const eff = shortSt.effectivePhase(channel, connPhase)
    const p = demo ? { text: i18n.t('st.demoLocal'), tone: 'warn', pulse: false }
      : (phoneDemo ? { text: i18n.t('st.demoPhone'), tone: 'warn', pulse: false } : shortSt.present(eff))
    // Chỉ nhấp nháy chấm khi đang hiển thị, không mở menu và đang ở pha chờ/kết nối
    const pulse = p.pulse && visible && !this.menuOpen
    this.setField('statusClass', 'st-' + p.tone)
    this.setField('dotClass', 'dot-' + p.tone + (pulse ? ' dot-pulse' : ''))
    if (!cfg.DEBUG_STATUS) {
      this.setField('status1', '')
      this.setField('status3', preRide && keepOnFailed ? i18n.t('hint.screenOff') : '')
      this.setField('status2', p.text)
      return
    }
    this.setField('status1', (demo ? 'DEMO ' : '') + (channel === 'A' ? 'LIVE ' : '') + statusA + ' #' + tickN)
    this.setField('status3', diagC)
    this.setField('status2', ((channel === 'C' ? 'LIVE ' : '') + statusC + (extra ? ' ' + extra : '')).trim())
  },

  render() {
    const now = Date.now()
    const st = demo || live
    const ev = hud.tick(st, now)
    if (ev === 'lost') { L.log('stale', 'pulse'); this.dismissMenu(); buzz.cancel(); buzz.play('lost') }
    const v = hud.view(st, now)
    if (v.quiet && !demo && buzz && buzz.active()) buzz.cancelTurn()   // tin cũ: không để xung báo rẽ đang chờ/chạy vượt ngưỡng trên khoảng cách cũ
    // Chỉ hướng dẫn THẬT (không chạy thử cục bộ, không chạy thử từ ĐT) mới khóa menu khi mất tin giữa tuyến
    routeActive = hud.nextRouteActive(routeActive, v.mode, !!demo, v.phoneDemo)
    if (hud.shouldCloseMenu({
      menuOpen: this.menuOpen, mode: v.mode, routeActive: routeActive, pulseActive: !!(buzz && buzz.active()), vibe: null
    })) this.setMenu(false)
    if (v.mode !== lastMode) { L.log('mode', lastMode + '->' + v.mode); lastMode = v.mode }

    const ringCls = v.mode === 'stale' ? 'ring-stale'
      : (v.mode === 'arrived' ? 'ring-arrived'
        : (v.mode === 'recalc' ? 'ring-recalc'
          : (v.mode === 'nav' ? (v.urgency === 'near' ? 'ring-near' : (v.urgency === 'far' ? 'ring-far' : 'ring-nav')) : 'ring-idle')))

    const isWait = !demo && v.mode === 'waiting' && !v.distance && !v.street
    const pre = isWait ? shortSt.preRide(shortSt.effectivePhase(channel, connPhase)) : null
    const bannerBase = v.mode === 'stale' ? 'banner-stale'
      : (v.mode === 'arrived' ? 'banner-arrived'
        : (v.mode === 'waiting' ? (pre && pre.bannerTone === 'err' ? 'banner-stale' : 'banner-wait') : ''))
    const bannerCls = isWait ? bannerBase : (bannerBase + ' banner-center').trim()
    const subHint = isWait ? pre.hint
      : (v.mode === 'stale' ? i18n.t('hint.stale')
        : (v.mode === 'arrived' ? i18n.t('hint.arrived')
          : (v.mode === 'recalc' ? i18n.t('hint.recalc') : '')))
    phoneDemo = !demo && v.phoneDemo
    preRide = isWait

    this.setField('arcPercent', v.arcPercent)
    this.setField('ringClass', ringCls)
    this.setField('dialClass', v.urgency === 'near' ? 'dial-near' : (v.urgency === 'far' ? 'dial-far' : ''))
    this.setField('dialInClass', v.urgency === 'near' ? 'dial-in-near' : (v.urgency === 'far' ? 'dial-in-far' : ''))
    this.setField('arrow', v.arrow || '')
    this.setField('exitBadge', v.exitBadge || '')
    this.setField('distance', v.distance)
    this.setField('quietMark', v.quiet ? i18n.t('quiet.mark', v.quietSec) : '')
    this.setField('clockNow', clockStr())
    this.setField('distClass', v.urgency === 'near' ? 'dist-near' : (v.urgency === 'far' ? 'dist-far' : ''))
    this.setField('banner', isWait ? pre.banner : v.banner)
    this.setField('bannerClass', bannerCls)
    this.setField('hint', subHint)
    this.setField('hintClass', isWait ? '' : 'hint-center')
    this.setField('showWaitActions', isWait)
    // Khi đã có huy hiệu LỐI X riêng, dòng street hiện tên đường gọn hơn
    this.setField('street', v.exitBadge ? v.road : v.street)
    const bot = v.mode === 'nav' ? (showClock ? i18n.t('clock', clockStr()) : v.bottom) : ''
    this.setField('bottomText', bot)
    this.syncRenderTimer(!!demo || v.mode !== 'waiting')
    this.refreshStatus()
  },

  onSwipe(e) {
    if (!e) return
    if (e.direction === 'up') this.tryOpenMenu()
    else if (e.direction === 'down' && this.menuOpen) { this.setMenu(false) }
  },

  onToggleClock() {
    showClock = !showClock
    this.render()
  },

  onStatusTap() {
    if (demo) { this.stopDemo(); this.render(); return }
    this.tryOpenMenu()
  },

  onTapDemo() {
    if (demo) { this.stopDemo(); this.render(); return }
    this.startDemo()
  },

  onOpenMenu() { this.tryOpenMenu() },

  // Mọi đường vào menu đều qua đây: không mở khi có hướng dẫn trực tiếp / mất tin giữa tuyến / đang rung
  tryOpenMenu() {
    if (!hud.canOpenMenu({ mode: lastMode, routeActive: routeActive, pulseActive: !!(buzz && buzz.active()) })) return
    this.setMenu(true)
    this.syncMenuLabels()
  },

  onCloseMenu() {
    this.setMenu(false)
  },

  onCyclePreset() {
    userTouchedPreset = true
    const idx = hud.PRESET_ORDER.indexOf(presetKey)
    presetKey = hud.PRESET_ORDER[(idx + 1) % hud.PRESET_ORDER.length]
    hud.applyPreset(live, presetKey)
    if (demo) hud.applyPreset(demo, presetKey)
    if (presetKey === 'off' && buzz) buzz.cancelTurn()
    try { storage.set({ key: KEY_PRESET, value: presetKey }) } catch (e) {}
    this.syncMenuLabels()
    this.render()
  },

  onCycleBright() {
    userTouchedBright = true
    const idx = BRIGHT_ORDER.indexOf(brightMode)
    brightMode = BRIGHT_ORDER[(idx + 1) % BRIGHT_ORDER.length]
    this.applyBrightness()
    try { storage.set({ key: KEY_BRIGHT, value: brightMode }) } catch (e) {}
    this.syncMenuLabels()
  },

  onToggleDemoFromMenu() {
    if (demo) this.stopDemo()
    else this.startDemo()
    this.setMenu(false)
    this.syncMenuLabels()
    this.render()
  },

  startDemo() {
    if (hud.hasFreshGuidance(live, Date.now())) return   // không để chạy thử đè hướng dẫn thật
    this.dismissMenu()
    demo = hud.createState()
    hud.applyPreset(demo, presetKey)
    demoStepIdx = 0
    demoSubTick = 0
    demoQ = 0
    buzz.cancel()
    const tickMs = cfg.DEMO_TICK_MS || 1000
    const ticksPerStep = Math.max(1, Math.round((cfg.DEMO_STEP_MS || 4000) / tickMs))
    const step = () => {
      if (!demo) return
      demoQ++
      const r = hud.accept(demo, hud.parsePayload(hud.demoMessage(demoStepIdx, demoQ, demoSubTick, ticksPerStep)), Date.now())
      this.applyVibe(r)
      demoSubTick++
      if (demoSubTick >= ticksPerStep) {
        demoSubTick = 0
        demoStepIdx++
      }
      this.render()
    }
    step()
    demoTimer = setInterval(step, tickMs)
    this.syncMenuLabels()
  },

  stopDemo() {
    if (demoTimer) { clearInterval(demoTimer); demoTimer = null }
    if (demo) { demo = null; if (buzz) buzz.cancel() }
    this.syncMenuLabels()
  }
}
</script>

{
  "package": "com.example.motonavhud",
  "name": "Moto Nav HUD",
  "versionName": "0.0.1",
  "versionCode": 1,
  "icon": "/common/arrow.png",
  "display": { "backgroundColor": "#000000" },
  "simulationVersion": "default",
  "deviceTypeList": ["watch"],
  "features": [
    { "name": "system.router" },
    { "name": "system.brightness" },
    { "name": "system.vibrator" },
    { "name": "system.interconnect" }
  ],
  "config": { "logLevel": "log", "designWidth": 480 },
  "router": {
    "entry": "pages/index",
    "pages": { "pages/index": { "component": "index" } }
  }
}
